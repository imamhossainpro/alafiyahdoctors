{
  "expo": {
    "name": "Al Afiyah Hospital",
    "slug": "alafiyah-hospital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "alafiyah",
    "updates": {
      "url": "https://u.expo.dev/68d7a24c-dbb9-4a69-ac63-97114cfa43a5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1c5fa8"
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.alafiyah.hospital",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1c5fa8"
      }
    },
    "extra": {
      "eas": {
        "projectId": "68d7a24c-dbb9-4a69-ac63-97114cfa43a5"
      }
    }
  }
}