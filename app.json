{
  "expo": {
    "name": "Al Afiyah Hospital",
    "slug": "alafiyah-hospital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "alafiyah",
    "updates": {
      "url": "https://u.expo.dev/68d7a24c-dbb9-4a69-ac63-97114cfa43a5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1c5fa8"
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.524797545432-kshfpc8t138plq7dv3qb0tbe0707as5h"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "android": {
      "package": "com.alafiyah.hospital",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#1c5fa8"
      }
    },
    "extra": {
      "eas": {
        "projectId": "68d7a24c-dbb9-4a69-ac63-97114cfa43a5"
      }
    }
  }
}